# Copy to .env and fill in. .env is git-ignored.

POSTGRES_PASSWORD=change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TRIAGEIQ_SECRET_KEY=change-me

# First admin account, created on start if it does not exist (signup is admin-only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
ADMIN_TEAM=ops

# Local LLM; ticket text is only ever sent here
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b

# Where browsers reach the API, and which dashboard origins may call it
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
